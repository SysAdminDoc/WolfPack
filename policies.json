{
    "policies": {
        "AppUpdateURL": "https://localhost",
        "DisableAppUpdate": true,
        "OverrideFirstRunPage": "",
        "OverridePostUpdatePage": "",
        "DisableSystemAddonUpdate": true,
        "DisableProfileImport": false,
        "DisableFirefoxStudies": true,
        "DisableTelemetry": true,
        "DisableFeedbackCommands": true,
        "DisablePocket": true,
        "DisableSetDesktopBackground": false,
        "DisableDeveloperTools": false,
        "NoDefaultBookmarks": true,
        "Extensions": {
            "Install": [
                "https://addons.mozilla.org/firefox/downloads/latest/sponsorblock/latest.xpi",
                "https://addons.mozilla.org/firefox/downloads/latest/reddit-enhancement-suite/latest.xpi",
                "https://addons.mozilla.org/firefox/downloads/latest/adaptive-tab-bar-colour/latest.xpi",
                "https://github.com/SysAdminDoc/uBlockVanced/releases/latest/download/uBlockVanced-firefox.xpi",
                "https://github.com/SysAdminDoc/DarkReaderLocal/releases/latest/download/DarkReaderLocal-firefox.xpi",
                "https://github.com/SysAdminDoc/ScriptVault/releases/latest/download/ScriptVault-firefox.xpi",
                "https://github.com/SysAdminDoc/StyleKit/releases/latest/download/StyleKit-firefox.xpi"
            ],
            "Uninstall": [
                "bing@search.mozilla.org",
                "amazondotcom@search.mozilla.org",
                "ebay@search.mozilla.org",
                "twitter@search.mozilla.org"
            ]
        },
        "SearchEngines": {
            "PreventInstalls": false,
            "Remove": [
                "Bing",
                "Amazon.com",
                "eBay",
                "Twitter"
            ],
            "Add": [
                {
                    "Name": "DuckDuckGo",
                    "Description": "Privacy-focused search engine",
                    "Alias": "@ddg",
                    "Method": "GET",
                    "URLTemplate": "https://duckduckgo.com/?q={searchTerms}",
                    "SuggestURLTemplate": "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
                    "IconURL": "https://duckduckgo.com/favicon.ico"
                },
                {
                    "Name": "DuckDuckGo Lite",
                    "Description": "Minimal, ad-free version of DuckDuckGo",
                    "Alias": "@ddgl",
                    "Method": "POST",
                    "URLTemplate": "https://start.duckduckgo.com/lite/?q={searchTerms}",
                    "PostData": "q={searchTerms}",
                    "IconURL": "https://duckduckgo.com/favicon.ico"
                },
                {
                    "Name": "SearXNG",
                    "Description": "A privacy-respecting metasearch engine",
                    "Alias": "@sx",
                    "Method": "POST",
                    "URLTemplate": "https://searx.be/?q={searchTerms}",
                    "PostData": "q={searchTerms}&category_general=on",
                    "IconURL": "https://searx.be/favicon.ico"
                },
                {
                    "Name": "StartPage",
                    "Description": "Google results without the tracking",
                    "Alias": "@sp",
                    "Method": "GET",
                    "URLTemplate": "https://www.startpage.com/sp/search?query={searchTerms}&cat=web&pl=opensearch",
                    "IconURL": "https://www.startpage.com/favicon.ico"
                },
                {
                    "Name": "YouTube",
                    "Description": "Search YouTube videos",
                    "Alias": "@yt",
                    "Method": "GET",
                    "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}",
                    "IconURL": "https://www.youtube.com/favicon.ico"
                },
                {
                    "Name": "Reddit",
                    "Description": "Search Reddit",
                    "Alias": "@r",
                    "Method": "GET",
                    "URLTemplate": "https://www.reddit.com/search/?q={searchTerms}",
                    "IconURL": "https://www.reddit.com/favicon.ico"
                },
                {
                    "Name": "GitHub",
                    "Description": "Search GitHub repositories",
                    "Alias": "@gh",
                    "Method": "GET",
                    "URLTemplate": "https://github.com/search?q={searchTerms}",
                    "IconURL": "https://github.com/favicon.ico"
                },
                {
                    "Name": "Wikipedia",
                    "Description": "Search Wikipedia",
                    "Alias": "@w",
                    "Method": "GET",
                    "URLTemplate": "https://en.wikipedia.org/wiki/Special:Search?search={searchTerms}",
                    "IconURL": "https://en.wikipedia.org/favicon.ico"
                },
                {
                    "Name": "Google Maps",
                    "Description": "Search Google Maps",
                    "Alias": "@maps",
                    "Method": "GET",
                    "URLTemplate": "https://www.google.com/maps/search/{searchTerms}",
                    "IconURL": "https://www.google.com/favicon.ico"
                }
            ]
        },
        "SupportMenu": {
            "Title": "WolfPack on GitHub",
            "URL": "https://github.com/SysAdminDoc/WolfPack/issues"
        },
        "Containers": {
            "Default": [
                {
                    "name": "Personal",
                    "icon": "fingerprint",
                    "color": "blue"
                },
                {
                    "name": "Work",
                    "icon": "briefcase",
                    "color": "orange"
                },
                {
                    "name": "Shopping",
                    "icon": "cart",
                    "color": "green"
                },
                {
                    "name": "Banking",
                    "icon": "dollar",
                    "color": "yellow"
                }
            ]
        },
        "ManagedBookmarks": [
            { "toplevel_name": "WolfPack" },
            {
                "name": "Privacy Tools",
                "children": [
                    { "url": "https://privacyguides.org", "name": "Privacy Guides" },
                    { "url": "https://tosdr.org", "name": "ToS;DR" },
                    { "url": "https://haveibeenpwned.com", "name": "Have I Been Pwned?" },
                    { "url": "https://bitwarden.com", "name": "Bitwarden" },
                    { "url": "https://nextdns.io", "name": "NextDNS" }
                ]
            },
            {
                "name": "Dev Tools",
                "children": [
                    { "url": "https://github.com", "name": "GitHub" },
                    { "url": "https://regex101.com", "name": "Regex101" },
                    { "url": "https://jsonformatter.curiousconcept.com", "name": "JSON Formatter" },
                    { "url": "https://caniuse.com", "name": "Can I Use" },
                    { "url": "https://devdocs.io", "name": "DevDocs" }
                ]
            },
            {
                "name": "Speed Tests",
                "children": [
                    { "url": "https://speed.cloudflare.com", "name": "Cloudflare Speed" },
                    { "url": "https://fast.com", "name": "Fast.com" },
                    { "url": "https://www.dnsleaktest.com", "name": "DNS Leak Test" },
                    { "url": "https://browserleaks.com", "name": "BrowserLeaks" }
                ]
            }
        ],
        "3rdparty": {
            "Extensions": {
                "uBlock0@AyGrush": {
                    "adminSettings": {
                        "selectedFilterLists": [
                            "user-filters",
                            "ublock-filters",
                            "ublock-badware",
                            "ublock-privacy",
                            "ublock-quick-fixes",
                            "ublock-unbreak",
                            "easylist",
                            "easyprivacy",
                            "urlhaus-1",
                            "plowe-0",
                            "fanboy-cookiemonster",
                            "ublock-annoyances",
                            "fanboy-annoyance",
                            "fanboy-social",
                            "adguard-annoyance",
                            "adguard-social",
                            "adguard-spyware-url",
                            "block-lan",
                            "dpollock-0"
                        ]
                    }
                },
                "sponsorBlocker@ajay.app": {
                    "categorySelections": [
                        {"name": "sponsor", "option": 1},
                        {"name": "selfpromo", "option": 1},
                        {"name": "interaction", "option": 1},
                        {"name": "intro", "option": 2},
                        {"name": "outro", "option": 2},
                        {"name": "preview", "option": 2},
                        {"name": "music_offtopic", "option": 0},
                        {"name": "filler", "option": 2}
                    ]
                }
            }
        },
        "Permissions": {
            "Camera": {
                "BlockNewRequests": true
            },
            "Microphone": {
                "BlockNewRequests": true
            },
            "Location": {
                "BlockNewRequests": true
            },
            "Notifications": {
                "BlockNewRequests": true
            },
            "Autoplay": {
                "Default": "block-audio-video"
            }
        }
    }
}
