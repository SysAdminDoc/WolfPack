<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="SysAdminDoc.WolfPack"
    Publisher="CN=SysAdminDoc"
    Version="__PACKAGE_VERSION__"
    ProcessorArchitecture="__PROCESSOR_ARCHITECTURE__" />
  <Properties>
    <DisplayName>WolfPack</DisplayName>
    <PublisherDisplayName>SysAdminDoc</PublisherDisplayName>
    <Description>Privacy-focused LibreWolf distribution for Windows.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application
      Id="WolfPack"
      Executable="WolfPack.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WolfPack"
        Description="Privacy-focused LibreWolf distribution for Windows."
        BackgroundColor="#1e1e2e"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
    </Application>
  </Applications>
</Package>
