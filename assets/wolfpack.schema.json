{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WolfPack build configuration",
  "description": "Validated by scripts/Validate-WolfPackConfig.ps1 before packaging.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "search", "profile", "extensions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback", "regionDefaults"],
      "properties": {
        "fallback": { "type": "string", "minLength": 1 },
        "regionDefaults": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userOverridesFile", "autoPinExtensions"],
      "properties": {
        "userOverridesFile": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+$" },
        "autoPinExtensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "installUrl", "fallbackUrls", "supportedManifestVersions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "installUrl": { "type": "string", "pattern": "^https://" },
          "fallbackUrls": {
            "type": "array",
            "items": { "type": "string", "pattern": "^https://" },
            "uniqueItems": true
          },
          "supportedManifestVersions": {
            "type": "array",
            "items": { "type": "integer", "enum": [2, 3] },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
